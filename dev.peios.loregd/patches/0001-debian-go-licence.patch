Subject: [PATCH] metadata: retain the versioned Debian Go toolchain notice
Origin: other, Peios catalogue qualification review
Upstream-Status: Pending [reference distribution licence layout]

Preserve complete notices from the exact Go major/minor source package when
the distribution relocates GOROOT/LICENSE. Never substitute the unversioned
golang-go metapackage notice or silently omit a missing toolchain licence.

--- a/tools/collect-go-metadata.py
+++ b/tools/collect-go-metadata.py
@@ -12,6 +12,7 @@
 import argparse
 import json
 import os
+import re
 from pathlib import Path, PurePosixPath
 import shutil
 import subprocess
@@ -33,6 +34,19 @@
     "EmbedFiles",
 )
 LICENCE_NAMES = ("license", "licence", "copying", "notice", "patents")
+
+
+def go_licence(goroot: Path, version: str, documentation: Path = Path("/usr/share/doc")) -> Path:
+    # Debian keeps the full toolchain notice in its versioned source package;
+    # golang-go's unversioned copyright covers only the dependency metapackage.
+    candidates = [goroot / "LICENSE", Path("/usr/share/licenses/org.golang.go/LICENSE")]
+    match = re.fullmatch(r"go([0-9]+\.[0-9]+)(?:\.[0-9]+)?", version)
+    if match:
+        candidates.append(documentation / ("golang-" + match.group(1) + "-src") / "copyright")
+    for candidate in candidates:
+        if candidate.is_file():
+            return candidate
+    raise RuntimeError("Go toolchain licence is missing from its recognized package locations")
 
 
 def records(raw: str):
@@ -124,20 +138,9 @@
             modules.setdefault(module["Path"], (module, source_dir, import_path))
 
     goroot = Path(subprocess.check_output(["go", "env", "GOROOT"], text=True).strip())
-    go_licence = next(
-        (
-            candidate
-            for candidate in (
-                goroot / "LICENSE",
-                Path("/usr/share/licenses/org.golang.go/LICENSE"),
-            )
-            if candidate.is_file()
-        ),
-        None,
-    )
-    if go_licence is None:
-        raise RuntimeError("Go toolchain licence is missing from its recognized package locations")
-    copy_unique(go_licence, args.licence_root / "go" / "LICENSE")
+    toolchain_version = subprocess.check_output(["go", "env", "GOVERSION"], text=True).strip()
+    licence = go_licence(goroot, toolchain_version)
+    copy_unique(licence, args.licence_root / "go" / "LICENSE")
     go_patents = goroot / "PATENTS"
     if go_patents.is_file():
         copy_unique(go_patents, args.licence_root / "go" / "PATENTS")
