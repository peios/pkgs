Subject: [PATCH] build: use the declared rolling Go toolchain without auto-downloads
Origin: other, Peios catalogue qualification review
Upstream-Status: Pending [upstream tracking and compiler input provenance]

Keep the tested minimum compiler version while allowing newer qualified Go
releases. Every phase uses GOTOOLCHAIN=local, including online acquisition,
so a module version bump cannot silently fetch an undeclared compiler.

--- a/pekit.toml
+++ b/pekit.toml
@@ -12,6 +12,7 @@
 [build.vendor]
 command = '''
 set -eu
+export GOTOOLCHAIN=local
 export GOCACHE="$PEKIT_OUT/gocache"
 export GOMODCACHE="$PEKIT_OUT/modcache"
 export GOENV=off GOWORK=off
@@ -38,7 +39,7 @@
 '''
 
 [build.vendor.dependencies.peipkg]
-"org.golang.go"               = ">= 1.26.5, < 1.27"
+"org.golang.go"               = ">= 1.26.5"
 "org.mozilla.ca-certificates" = "*"
 "org.git.kernel.dash"         = "*"
 "org.gnu.coreutils"           = "*"
@@ -88,7 +89,7 @@
 cp -a "$PEKIT_VENDOR_OUT/vendor" "$BUILD/vendor"
 
 export CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOAMD64=v1
-export GOENV=off GOTOOLCHAIN=auto GOWORK=off GOPROXY=off GOSUMDB=sum.golang.org
+export GOENV=off GOTOOLCHAIN=local GOWORK=off GOPROXY=off GOSUMDB=sum.golang.org
 export GOFLAGS='-mod=vendor -trimpath -buildvcs=false'
 export GOMODCACHE="$PEKIT_VENDOR_OUT/modcache"
 export GOCACHE="$PEKIT_OUT/gocache-a"
@@ -136,7 +137,7 @@
 '''
 
 [build.main.dependencies.peipkg]
-"org.golang.go"       = ">= 1.26.5, < 1.27"
+"org.golang.go"       = ">= 1.26.5"
 "org.git.kernel.dash" = "*"
 "org.gnu.coreutils"   = "*"
 "org.gnu.diffutils"   = "*"
@@ -178,7 +179,7 @@
 rm -rf "$BUILD/vendor" "$BUILD/loregd"
 cp -a "$PEKIT_VENDOR_OUT/vendor" "$BUILD/vendor"
 export CGO_ENABLED=0 GOOS=linux GOARCH=amd64 GOAMD64=v1
-export GOENV=off GOTOOLCHAIN=auto GOWORK=off GOPROXY=off GOSUMDB=sum.golang.org
+export GOENV=off GOTOOLCHAIN=local GOWORK=off GOPROXY=off GOSUMDB=sum.golang.org
 export GOFLAGS='-mod=vendor -trimpath -buildvcs=false'
 export GOMODCACHE="$PEKIT_VENDOR_OUT/modcache"
 export GOCACHE="$PEKIT_OUT/gocache"
@@ -229,7 +230,7 @@
 '''
 
 [test.dependencies.peipkg]
-"org.golang.go"       = ">= 1.26.5, < 1.27"
+"org.golang.go"       = ">= 1.26.5"
 "org.git.kernel.dash" = "*"
 "org.gnu.coreutils"   = "*"
 "org.gnu.diffutils"   = "*"
