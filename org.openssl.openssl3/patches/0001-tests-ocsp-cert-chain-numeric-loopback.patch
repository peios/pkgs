Description: Use numeric loopback in the OCSP certificate-chain test
Author: Peios maintainers <packaging@peios.org>
Origin: vendor
Forwarded: not-needed
Scope: test harness only

Peios resolves host names only through resolvd, and the offline build root
runs no resolver service, so "localhost" does not resolve there. This one
fixture only needs two local connections, not a name-service integration
test: connect to 127.0.0.1 instead, retaining all three upstream assertions.
The patch fails to apply if upstream changes these lines, rather than a
substitution silently stopping.

--- a/test/recipes/82-test_ocsp_cert_chain.t
+++ b/test/recipes/82-test_ocsp_cert_chain.t
@@ -87,10 +87,10 @@

     # openssl s_server -accept 0 -naccept 1 \
     #                  -cert server.pem -cert_chain intermediate-cert.pem \
-    #                  -status_verbose -status_url http://localhost:19254/ocsp
+    #                  -status_verbose -status_url http://127.0.0.1:19254/ocsp
     my @s_server_cmd = ("s_server", "-accept", "0", "-naccept", "1",
                         "-cert", $server_pem, "-cert_chain", $intermediate_cert_pem,
-                        "-status_verbose", "-status_url", "http://localhost:${ocsp_port}/ocsp");
+                        "-status_verbose", "-status_url", "http://127.0.0.1:${ocsp_port}/ocsp");
     my $s_server_pid = open3(my $s_server_i, my $s_server_o, my $s_server_e = gensym, $shlib_wrap, $apps_openssl, @s_server_cmd);

     # ACCEPT 0.0.0.0:45921
@@ -116,8 +116,8 @@

     print("s_server ready, listening on port $server_port\n");

-    # openssl s_client -connect localhost:45921 -status -verify_return_error
-    my @s_client_cmd = ("s_client", "-connect", "localhost:$server_port", "-status", "-verify_return_error");
+    # openssl s_client -connect 127.0.0.1:45921 -status -verify_return_error
+    my @s_client_cmd = ("s_client", "-connect", "127.0.0.1:$server_port", "-status", "-verify_return_error");
     my $s_client_pid = open3(my $s_client_i, my $s_client_o, my $s_client_e = gensym, $shlib_wrap, $apps_openssl, @s_client_cmd);

     waitpid($s_client_pid, 0);
