+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+include "llvm/Option/OptParser.td"
+
+multiclass Dimension<string name, string help> {
+  def NAME : Separate<["--", "-"], name>, HelpText<help>;
+  def : Joined<["--", "-"], name # "=">, Alias<!cast<Separate>(NAME)>;
+}
+defm threads_x : Dimension<"threads-x", "Number of threads in the 'x' dimension">;
+defm threads_y : Dimension<"threads-y", "Number of threads in the 'y' dimension">;
+defm threads_z : Dimension<"threads-z", "Number of threads in the 'z' dimension">;
+defm blocks_x : Dimension<"blocks-x", "Number of blocks in the 'x' dimension">;
+defm blocks_y : Dimension<"blocks-y", "Number of blocks in the 'y' dimension">;
+defm blocks_z : Dimension<"blocks-z", "Number of blocks in the 'z' dimension">;
+def : Separate<["--", "-"], "threads">, Alias<threads_x>, HelpText<"Alias for --threads-x">;
+def : Joined<["--", "-"], "threads=">, Alias<threads_x>;
+def : Separate<["--", "-"], "blocks">, Alias<blocks_x>, HelpText<"Alias for --blocks-x">;
+def : Joined<["--", "-"], "blocks=">, Alias<blocks_x>;
+def help : Flag<["--", "-"], "help">, HelpText<"Display this help">;
+def : Flag<["--", "-"], "h">, Alias<help>;
+def version : Flag<["--", "-"], "version">, HelpText<"Display the version">;
