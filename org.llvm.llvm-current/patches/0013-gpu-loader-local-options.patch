+++ b/llvm/tools/llvm-gpu-loader/llvm-gpu-loader-options.h
@@ -0,0 +1,139 @@
+//===-- Tool-local GPU loader options ----------------------------*- C++
+//-*-===//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_TOOLS_LLVM_GPU_LOADER_OPTIONS_H
+#define LLVM_TOOLS_LLVM_GPU_LOADER_OPTIONS_H
+
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Option/Arg.h"
+#include "llvm/Option/ArgList.h"
+#include "llvm/Option/OptTable.h"
+#include "llvm/Option/Option.h"
+#include "llvm/Support/CommandLine.h"
+#include "llvm/Support/Error.h"
+#include "llvm/Support/StringSaver.h"
+#include <string>
+#include <vector>
+
+namespace llvm::gpu_loader {
+enum ID {
+  OPT_INVALID = 0,
+#define OPTION(...) LLVM_MAKE_OPT_ID(__VA_ARGS__),
+#include "Opts.inc"
+#undef OPTION
+  OPT_LAST
+};
+#define OPTTABLE_STR_TABLE_CODE
+#include "Opts.inc"
+#undef OPTTABLE_STR_TABLE_CODE
+#define OPTTABLE_PREFIXES_TABLE_CODE
+#include "Opts.inc"
+#undef OPTTABLE_PREFIXES_TABLE_CODE
+using opt::DefaultVis;
+static constexpr opt::OptTable::Info InfoTable[] = {
+#define OPTION(...) LLVM_CONSTRUCT_OPT_INFO(__VA_ARGS__),
+#include "Opts.inc"
+#undef OPTION
+};
+class LoaderOptTable : public opt::GenericOptTable {
+public:
+  LoaderOptTable()
+      : GenericOptTable(OptionStrTable, OptionPrefixesTable, InfoTable) {}
+};
+
+struct Options {
+  unsigned ThreadsX = 1, ThreadsY = 1, ThreadsZ = 1;
+  unsigned BlocksX = 1, BlocksY = 1, BlocksZ = 1;
+  std::string File;
+  std::vector<std::string> Args;
+  bool Help = false, Version = false;
+};
+
+// Do not register tool options in llvm::cl's process-wide registry: libLLVM's
+// ThinLTO code also owns a "threads" option. ParseOneArg lets us preserve the
+// ConsumeAfter interface: every argument following the image belongs to it.
+inline Expected<Options> parseOptions(int Argc, const char *const *Argv) {
+  BumpPtrAllocator Alloc;
+#ifdef _WIN32
+  auto Tokenize = cl::TokenizeWindowsCommandLine;
+#else
+  auto Tokenize = cl::TokenizeGNUCommandLine;
+#endif
+  cl::ExpansionContext Expansion(Alloc, Tokenize);
+  SmallVector<const char *, 20> Expanded(Argv, Argv + Argc);
+  if (Error E = Expansion.expandResponseFiles(Expanded))
+    return std::move(E);
+  opt::InputArgList Input(Expanded.data() + 1,
+                          Expanded.data() + Expanded.size());
+  LoaderOptTable Table;
+  Options Result;
+  bool Seen[OPT_LAST] = {};
+  unsigned I = 0;
+  while (I < Input.getNumInputArgStrings()) {
+    StringRef Raw(Input.getArgString(I));
+    if (Raw == "--") {
+      ++I;
+      if (I == Input.getNumInputArgStrings())
+        break;
+      Result.File = Input.getArgString(I++);
+      break;
+    }
+    auto A = Table.ParseOneArg(Input, I);
+    if (!A)
+      return createStringError("missing value for option '%s'",
+                               Raw.str().c_str());
+    unsigned Kind = A->getOption().getID();
+    if (Kind == OPT_INPUT) {
+      Result.File = A->getValue();
+      break;
+    }
+    if (Kind == OPT_UNKNOWN)
+      return createStringError("unknown option '%s'", Raw.str().c_str());
+    if (Kind == OPT_help) {
+      Result.Help = true;
+      continue;
+    }
+    if (Kind == OPT_version) {
+      Result.Version = true;
+      continue;
+    }
+    if (Seen[Kind])
+      return createStringError("option '%s' may only occur once",
+                               A->getSpelling().str().c_str());
+    Seen[Kind] = true;
+    unsigned Value;
+    if (!to_integer(StringRef(A->getValue()), Value, 0))
+      return createStringError("invalid unsigned integer '%s' for option '%s'",
+                               A->getValue(), A->getSpelling().str().c_str());
+    switch (Kind) {
+    case OPT_threads_x:
+      Result.ThreadsX = Value;
+      break;
+    case OPT_threads_y:
+      Result.ThreadsY = Value;
+      break;
+    case OPT_threads_z:
+      Result.ThreadsZ = Value;
+      break;
+    case OPT_blocks_x:
+      Result.BlocksX = Value;
+      break;
+    case OPT_blocks_y:
+      Result.BlocksY = Value;
+      break;
+    case OPT_blocks_z:
+      Result.BlocksZ = Value;
+      break;
+    default:
+      llvm_unreachable("unexpected loader option");
+    }
+  }
+  while (I < Input.getNumInputArgStrings())
+    Result.Args.emplace_back(Input.getArgString(I++));
+  if (Result.File.empty() && !Result.Help && !Result.Version)
+    return createStringError("missing GPU executable");
+  return Result;
+}
+} // namespace llvm::gpu_loader
+#endif
