@@ -0,0 +1,22 @@
+# Tool options must not collide with options in LLVM_LINK_LLVM_DYLIB builds.
+# None of these checks requires a GPU or libLLVMOffload.
+# RUN: llvm-gpu-loader --help | FileCheck %s --check-prefix=HELP
+# RUN: llvm-gpu-loader -h | FileCheck %s --check-prefix=HELP
+# RUN: llvm-gpu-loader --threads=7 --blocks=3 --help | FileCheck %s --check-prefix=HELP
+# HELP: OVERVIEW: A utility used to launch unit tests built for a GPU target.
+# HELP: --blocks
+# HELP: --threads
+
+# Aliases must still refer to their x-dimension options.
+# RUN: not llvm-gpu-loader --threads=4 --threads-x=8 image 2>&1 | FileCheck %s --check-prefix=DUPLICATE
+# RUN: not llvm-gpu-loader --blocks=4 --blocks-x=8 image 2>&1 | FileCheck %s --check-prefix=DUPLICATE
+# DUPLICATE: may only occur once
+
+# RUN: not llvm-gpu-loader --threads=bad image 2>&1 | FileCheck %s --check-prefix=INVALID
+# RUN: not llvm-gpu-loader --threads=-1 image 2>&1 | FileCheck %s --check-prefix=INVALID
+# RUN: not llvm-gpu-loader --blocks-z=4294967296 image 2>&1 | FileCheck %s --check-prefix=INVALID
+# INVALID: invalid unsigned integer
+# RUN: not llvm-gpu-loader --threads 2>&1 | FileCheck %s --check-prefix=MISSING-VALUE
+# MISSING-VALUE: missing value for option
+# RUN: not llvm-gpu-loader 2>&1 | FileCheck %s --check-prefix=MISSING-IMAGE
+# MISSING-IMAGE: missing GPU executable
