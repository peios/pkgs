Author: Peios maintainers <packaging@peios.org>
Forwarded: not-needed
Subject: [PATCH] llvm: recognize Peios as a target environment

Peios uses x86_64-unknown-linux-peios. LLVM validates the environment
suffix as a version, so represent Peios explicitly rather than relying
on the permissive pre-22 parser. LLVM 23 generates environment names and
parsing from TripleName.def. Keep the enum and that table in agreement,
and exercise parsing, naming and normalization in the upstream unit suite.

diff --git a/llvm/include/llvm/TargetParser/Triple.h b/llvm/include/llvm/TargetParser/Triple.h
--- a/llvm/include/llvm/TargetParser/Triple.h
+++ b/llvm/include/llvm/TargetParser/Triple.h
@@ -412,7 +412,8 @@
 
     PAuthTest,
     MTIA,
-    LastEnvironmentType = MTIA
+    Peios,
+    LastEnvironmentType = Peios
   };
   enum ObjectFormatType {
     UnknownObjectFormat,
diff --git a/llvm/include/llvm/TargetParser/TripleName.def b/llvm/include/llvm/TargetParser/TripleName.def
--- a/llvm/include/llvm/TargetParser/TripleName.def
+++ b/llvm/include/llvm/TargetParser/TripleName.def
@@ -153,6 +153,7 @@
 TRIPLE_ENV(LLVM, "llvm")
 TRIPLE_ENV(Mlibc, "mlibc")
 TRIPLE_ENV(MTIA, "mtia")
+TRIPLE_ENV(Peios, "peios")
 
 #undef TRIPLE_ENV
 
diff --git a/llvm/unittests/TargetParser/TripleTest.cpp b/llvm/unittests/TargetParser/TripleTest.cpp
--- a/llvm/unittests/TargetParser/TripleTest.cpp
+++ b/llvm/unittests/TargetParser/TripleTest.cpp
@@ -835,6 +835,14 @@
   EXPECT_EQ(Triple::Meta, T.getVendor());
   EXPECT_EQ(Triple::UnknownOS, T.getOS());
   EXPECT_EQ(Triple::MTIA, T.getEnvironment());
+
+  T = Triple("x86_64-unknown-linux-peios");
+  EXPECT_EQ(Triple::x86_64, T.getArch());
+  EXPECT_EQ(Triple::UnknownVendor, T.getVendor());
+  EXPECT_EQ(Triple::Linux, T.getOS());
+  EXPECT_EQ(Triple::Peios, T.getEnvironment());
+  EXPECT_EQ("peios", Triple::getEnvironmentTypeName(T.getEnvironment()));
+  EXPECT_EQ("x86_64-unknown-linux-peios", Triple::normalize(T.str()));
 
   T = Triple("riscv64-unknown-linux");
   EXPECT_EQ(Triple::riscv64, T.getArch());
