--- /dev/null
+++ b/clang/test/SemaTemplate/peios-gcc16-hidden-friend.cpp
@@ -0,0 +1,35 @@
+// RUN: %clang_cc1 -std=c++11 -verify %s
+// RUN: %clang_cc1 -std=c++14 -verify %s
+// RUN: %clang_cc1 -std=c++17 -verify %s
+// RUN: %clang_cc1 -std=c++20 -verify %s
+// Reduced GCC16 normal_iterator hidden-friend trailing-return-type pattern.
+// The class is still being instantiated when the friend return type is formed.
+template <class Pointer> class Iterator {
+  Pointer current;
+public:
+  explicit Iterator(Pointer p) : current(p) {}
+  const Pointer &base() const { return current; }
+  template <class Other>
+  friend auto operator-(const Iterator &lhs, const Iterator<Other> &rhs)
+      -> decltype(lhs.base() - rhs.base()) { return lhs.base() - rhs.base(); }
+  friend auto operator-(const Iterator &lhs, const Iterator &rhs)
+      -> decltype(lhs.base() - rhs.base()) { return lhs.base() - rhs.base(); }
+};
+int distance(int *p) {
+  Iterator<int *> begin(p), end(p + 4);
+  Iterator<const int *> constant_end(p + 4);
+  return (end - begin) + (constant_end - begin);
+}
+// Member lookup must still reject absent members in the definition context.
+template <class T> struct NoSuchMember {
+  void f() { this->missing(); } // expected-error {{no member named 'missing'}}
+};
+// A dependent base legitimately defers lookup until instantiation.
+struct Base { int member() { return 7; } };
+template <class T> struct Derived : T { int f() { return this->member(); } };
+template struct Derived<Base>;
+// Do not weaken the completeness requirement for unrelated incomplete classes.
+struct Incomplete; // expected-note {{forward declaration of 'Incomplete'}}
+void incomplete(Incomplete *p) {
+  p->member(); // expected-error {{member access into incomplete type 'Incomplete'}}
+}
