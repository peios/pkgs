Description: Build a relocatable installed llvm-config without private build roots
Origin: vendor, PEIOS packaging

--- a/llvm/tools/llvm-config/CMakeLists.txt
+++ b/llvm/tools/llvm-config/CMakeLists.txt
@@ -16,6 +16,14 @@
   # for the native `llvm-config`!
   DISABLE_LLVM_LINK_LLVM_DYLIB
   )
+
+# The packaged tool is relocatable and must not retain private build roots.
+# Keep the upstream build-tree llvm-config unchanged for development and tests.
+add_llvm_executable(llvm-config-installed
+  llvm-config.cpp
+  DISABLE_LLVM_LINK_LLVM_DYLIB
+  )
+target_compile_definitions(llvm-config-installed PRIVATE PEIOS_INSTALLED_LLVM_CONFIG=1)
 
 # Compute the substitution values for various items.
 get_property(SUPPORT_SYSTEM_LIBS TARGET LLVMSupport PROPERTY LLVM_SYSTEM_LIBS)
