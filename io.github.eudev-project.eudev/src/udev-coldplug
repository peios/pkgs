#!/bin/sh
# udev-coldplug — replay the uevents that fired before udevd was listening.
#
# The kernel enumerates hardware long before PID 1 starts; every device it
# found emitted a uevent into nobody's socket. udevd only sees what happens
# after it binds, so at start something has to ask the kernel to say it all
# again: writing "add" to each device's uevent attribute re-emits the event,
# and udevd processes the replay exactly as it would a hot-plug.
#
# Run as the eudev service's ExecStartPost. peinit releases the service's
# dependents only once its post-hooks have finished, so a service that
# Requires eudev starts with the coldplug done and the queue drained — that is
# the whole of the "devices settled" guarantee, and it costs no second service.
#
# Readiness for udevd is Alive — the process exists — which says nothing about
# its sockets. A trigger that lands before the netlink socket is bound is lost
# for good, so the first step is to make udevd answer. A control reload is
# acknowledged from the event loop, and the loop starts after both sockets
# are bound, so an acknowledged reload is proof the replay will be heard.
set -eu

i=0
until /bin/udevadm control --reload 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -ge 100 ]; then
        echo "udev-coldplug: udevd did not answer its control socket within 10s" >&2
        exit 1
    fi
    sleep 0.1
done

# Static device nodes. The kernel's modules.devname lists the nodes whose
# module is loaded on first open (tun, fuse, uinput, ppp, ...) — but a node
# that does not exist cannot be opened, so somebody has to create it before
# the module is loaded. On systemd that is kmod-static-nodes plus tmpfiles;
# here it is this loop. udev's own static_node= option only adjusts the
# permissions of a node that already exists, it does not create one. The
# mknod needs SeTcbPrivilege, which the service holds.
#
# Format: one "<module> <name> <c|b><major>:<minor>" per line, comments with #.
devname="/lib/modules/$(uname -r)/modules.devname"
if [ -r "$devname" ]; then
    while read -r module name devnum; do
        case "$module" in ''|'#'*) continue ;; esac
        node="/dev/$name"
        [ -e "$node" ] && continue
        kind=${devnum%%[0-9]*}
        numbers=${devnum#?}
        major=${numbers%%:*}
        minor=${numbers#*:}
        mkdir -p "$(dirname "$node")"
        mknod "$node" "$kind" "$major" "$minor" \
            || echo "udev-coldplug: could not create $node for $module" >&2
    done < "$devname"
fi

# Subsystems first, so the per-subsystem state (module parameters, the block
# events poll interval 60-block.rules sets) is in place before the devices
# that depend on it are processed.
/bin/udevadm trigger --type=subsystems --action=add
/bin/udevadm trigger --type=devices --action=add
exec /bin/udevadm settle --timeout=30
