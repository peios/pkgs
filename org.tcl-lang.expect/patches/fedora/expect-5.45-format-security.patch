Description: Never pass a non-literal format string to fprintf
 Debug and log text went to fprintf as the format; with a % in it that is
 undefined behaviour, and -Werror=format-security rejects it.
Origin: vendor, https://src.fedoraproject.org/rpms/expect/blob/rawhide/f/expect-5.45-format-security.patch
Forwarded: not-needed
Last-Update: 2026-09-23

--- a/exp_clib.c	2017-03-24 10:34:37.269183513 -0400
+++ b/exp_clib.c	2017-03-24 10:34:41.171117943 -0400
@@ -1938,8 +1938,8 @@
      char *str;
 {
   if (exp_is_debugging) {
-    fprintf(stderr,str);
-    if (exp_logfile) fprintf(exp_logfile,str);
+    fprintf(stderr, "%s", str);
+    if (exp_logfile) fprintf(exp_logfile, "%s", str);
   }
 }
 
