#!/usr/bin/env python3
"""Narrow, recorded portability adjustments to disposable test inputs."""
import hashlib
import json
import re
import shutil
from pathlib import Path
import subprocess
import tarfile
import tomllib
import sys


def lazy_windows_ctypes(text):
    if '\nimport ctypes\n' not in text:
        return text  # upstream may already have made the import lazy
    expected = 'def is_hidden_Windows(path):\n    res = ctypes.windll.kernel32.GetFileAttributesW(path)'
    if text.count('\nimport ctypes\n') != 1 or text.count('ctypes.') != 1 or expected not in text:
        raise ValueError('jaraco.path ctypes usage changed; review the Windows-only portability adjustment')
    return text.replace('\nimport ctypes\n', '\n').replace(expected,
        'def is_hidden_Windows(path):\n    import ctypes\n\n    res = ctypes.windll.kernel32.GetFileAttributesW(path)')


def prepare(source, python, record):
    changes = []
    def edit(path, transform, reason):
        before = path.read_bytes()
        after = transform(before.decode()).encode()
        if before != after:
            path.write_bytes(after)
            changes.append({'path': str(path), 'reason': reason,
                            'before_sha256': hashlib.sha256(before).hexdigest(),
                            'after_sha256': hashlib.sha256(after).hexdigest()})
    edit(source / 'pytest.ini', lambda s: ''.join(line for line in s.splitlines(True)
            if 'coverage.exceptions.CoverageWarning' not in line),
         'Coverage instrumentation is not enabled; omit its optional warning category while retaining warning errors.')
    path = Path(subprocess.check_output([str(python), '-c',
        'import importlib.util; print(importlib.util.find_spec("jaraco.path").origin)'], text=True).strip())
    if not path.resolve().is_relative_to(python.parent.parent.resolve()):
        raise ValueError('jaraco.path is outside the private test environment')
    edit(path, lazy_windows_ctypes,
         'Load ctypes only inside the Windows implementation; Linux hidden-file tests do not require the optional native module.')
    # Runtime packages deliberately omit CPython's regression tests. Supply
    # its public test helpers from the matching, declared source package only
    # inside this private test venv, never from the developer's interpreter.
    available = subprocess.run([str(python), '-c', 'import test.support'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not available:
        version = subprocess.check_output([str(python), '-c',
            'import sys; print(".".join(map(str, sys.version_info[:3])))'], text=True).strip()
        candidates = []
        for root in Path('/usr/src/dist').glob('*/source'):
            header = root / 'Include/patchlevel.h'
            if not header.exists():
                continue
            match = re.search(r'^#define\s+PY_VERSION\s+"([^" ]+)"', header.read_text(), re.M)
            if match and match[1] == version and (root / 'Lib/test/support').is_dir():
                candidates.append(root)
        # Older source packages retain pristine archives instead of a prepared
        # tree. Verify the recorded source hash before extracting only support.
        if not candidates:
            for archive in Path('/usr/src/dist').glob(f'*/upstream/Python-{version}.tar.*'):
                lock = tomllib.loads((archive.parent.parent / 'recipe/pekit.lock').read_text())
                matches = [entry for entry in lock['source'] if entry['version'] == version]
                if len(matches) != 1:
                    raise ValueError('CPython source package has no unambiguous version lock')
                with archive.open('rb') as stream:
                    actual = hashlib.file_digest(stream, 'sha256').hexdigest()
                if actual != matches[0]['sha256']:
                    raise ValueError('CPython test source archive hash mismatch')
                with tarfile.open(archive) as tar:
                    header = tar.getmember(f'Python-{version}/Include/patchlevel.h')
                    header_text = tar.extractfile(header).read().decode()
                    match = re.search(r'^#define\s+PY_VERSION\s+"([^" ]+)"', header_text, re.M)
                    if not match or match[1] != version:
                        raise ValueError('CPython test source header does not match the interpreter')
                    prefix = f'Python-{version}/Lib/test/'
                    selected = [m for m in tar.getmembers() if m.name == prefix + '__init__.py'
                                or m.name == prefix + 'support' or m.name.startswith(prefix + 'support/')]
                    extracted = record.parent / 'cpython-test-source'
                    extracted.mkdir(exist_ok=True)
                    tar.extractall(extracted, members=selected, filter='data')
                    candidates.append(extracted / f'Python-{version}')
                changes.append({'archive': str(archive), 'sha256': actual,
                                'reason': 'Verified legacy corresponding-source archive for the running interpreter.'})
        if len(candidates) != 1:
            raise ValueError(f'expected one CPython {version} source package for test.support, found {len(candidates)}')
        site = Path(subprocess.check_output([str(python), '-c',
            'import sysconfig; print(sysconfig.get_path("purelib"))'], text=True).strip())
        if not site.resolve().is_relative_to(python.parent.parent.resolve()):
            raise ValueError('CPython test support destination escapes private environment')
        source_test = candidates[0] / 'Lib/test'
        destination = site / 'test'
        destination.mkdir()
        shutil.copy2(source_test / '__init__.py', destination / '__init__.py')
        shutil.copytree(source_test / 'support', destination / 'support')
        subprocess.run([str(python), '-c', 'from test.support import os_helper; assert callable(os_helper.can_symlink)'], check=True)
        changes.append({'source': str(source_test), 'python_version': version,
                        'reason': 'Matching CPython test.support, supplied only in the private test environment.'})
    record.write_text(json.dumps(changes, indent=2) + '\n')


if __name__ == '__main__':
    prepare(Path(sys.argv[1]), Path(sys.argv[2]), Path(sys.argv[3]))
