From: Peios package maintainers
Subject: Make local-socket and raw-ICMP tests honor NO_NETWORK_TESTING

Pekit's native build root has an intentionally empty network namespace. Its
namespace uid 0 has no raw-socket capability, and the loopback interface stays
down because the host forbids unprivileged network administration. Extend the
suite's existing NO_NETWORK_TESTING contract to the remaining tests which
otherwise assume that uid 0 and a usable loopback network are equivalent.

The installed modules are unchanged. Reference builds without the variable
continue to exercise every test.

diff --git a/dist/IO/t/io_multihomed.t b/dist/IO/t/io_multihomed.t
--- a/dist/IO/t/io_multihomed.t
+++ b/dist/IO/t/io_multihomed.t
@@ -3,6 +3,8 @@
 BEGIN {
     require($ENV{PERL_CORE} ? '../../t/test.pl' : './t/test.pl');
 
+    skip_all('network namespace has no loopback') if $ENV{NO_NETWORK_TESTING};
+
     use Config;
     my $can_fork = $Config{d_fork} ||
 		    (($^O eq 'MSWin32' || $^O eq 'NetWare') and
diff --git a/dist/IO/t/io_sock.t b/dist/IO/t/io_sock.t
--- a/dist/IO/t/io_sock.t
+++ b/dist/IO/t/io_sock.t
@@ -3,6 +3,10 @@
 use Config;
 
 BEGIN {
+    if ($ENV{NO_NETWORK_TESTING}) {
+        print "1..0 # Skip: network namespace has no loopback\n";
+        exit 0;
+    }
     my $can_fork = $Config{d_fork} ||
 		    (($^O eq 'MSWin32' || $^O eq 'NetWare') and
 		     $Config{useithreads} and 
