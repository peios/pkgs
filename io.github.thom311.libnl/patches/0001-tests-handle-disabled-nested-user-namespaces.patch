Description: Handle disabled nested namespaces in the upstream test harness
 Peios runs libnl's test suite inside the pekit build sandbox, where
 bubblewrap --disable-userns makes nested namespace creation fail with
 ENOSPC. Treat ENOSPC like EPERM using the existing no-private-netns skip
 path, so the suite runs to completion there. Only the test harness changes;
 the installed library is untouched. Kernel roundtrip coverage stays a
 separate acceptance requirement; never touch the host network namespace or
 relax the build sandbox to obtain a green result.
Author: Peios maintainers <packaging@peios.org>
Origin: vendor
Forwarded: no
Scope: test harness only

--- a/tests/nl-test-util.c
+++ b/tests/nl-test-util.c
@@ -145,7 +145,7 @@
 
 	/* Become a root in new user NS. */
 	r = unshare(CLONE_NEWUSER);
-	if (r != 0 && errno == EPERM) {
+	if (r != 0 && (errno == EPERM || errno == ENOSPC)) {
 		/* No permissions? Ignore. Will be handled later. */
 		return;
 	}
@@ -210,7 +210,7 @@
 	unshare_user();
 
 	r = unshare(CLONE_NEWNET | CLONE_NEWNS);
-	if (r != 0 && errno == EPERM) {
+	if (r != 0 && (errno == EPERM || errno == ENOSPC)) {
 		/* The system is probably sandboxed somehow and we are unable
 		 * to create a private netns. That seems questionable, because
 		 * a point of a private netns is to sandbox an application.
