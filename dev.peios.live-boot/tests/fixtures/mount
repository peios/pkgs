#!/usr/bin/sh
printf '%s\n' "$*" >> "$PEIOS_LIVE_BOOT_TEST_LOG/mount.args"

case "$1 ${2:-}" in
    "-t iso9660")
        if [ "$5" = "${PEIOS_LIVE_BOOT_MEDIUM_DEV:-}" ]; then
            : > "$6/rootfs.squashfs"
            exit 0
        fi
        exit 32
        ;;
    "-o loop,ro,policy=synth-ephemeral")
        exit "${PEIOS_LIVE_BOOT_SQUASHFS_STATUS:-0}"
        ;;
    "-t tmpfs")
        exit "${PEIOS_LIVE_BOOT_TMPFS_STATUS:-0}"
        ;;
    "-t overlay")
        exit "${PEIOS_LIVE_BOOT_OVERLAY_STATUS:-0}"
        ;;
    "--move "*)
        exit "${PEIOS_LIVE_BOOT_MOVE_STATUS:-0}"
        ;;
esac

exit 64
