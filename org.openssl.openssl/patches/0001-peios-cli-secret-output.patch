+#ifdef ENABLE_PEIOS
+static int app_private_rand_write(const char *filename)
+{
+    unsigned char bytes[1024]; /* RAND_write_file's RAND_BUF_SIZE */
+    BIO *out = NULL;
+    int ret = -1;
+    if (RAND_priv_bytes(bytes, sizeof(bytes)) != 1)
+        goto end;
+    out = bio_open_secret(filename, 'w', FORMAT_BINARY);
+    if (out != NULL && BIO_write(out, bytes, sizeof(bytes)) == sizeof(bytes)
+        && BIO_flush(out) > 0)
+        ret = sizeof(bytes);
+end:
+    if (BIO_free(out) <= 0)
+        ret = -1;
+    OPENSSL_cleanse(bytes, sizeof(bytes));
+    return ret;
+}
+#else
+#define app_private_rand_write RAND_write_file
+#endif
