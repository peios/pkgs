+/* This is CLI file policy; libcrypto's general BIO API remains unchanged. */
+BIO *bio_open_secret(const char *filename, char mode, int format)
+{
+#ifdef ENABLE_PEIOS
+    BIO *bio;
+    FILE *fp;
+    int fd;
+    if (filename == NULL || strcmp(filename, "-") == 0)
+        return bio_open_default(filename, mode, format);
+    fd = peios_secret_fd(filename, mode);
+    if (fd < 0) {
+        secret_output_failed = 1;
+        BIO_printf(bio_err, "Cannot safely open private output %s: %s\n",
+            filename, strerror(errno));
+        return NULL;
+    }
+    fp = fdopen(fd, mode == 'a' ? "ab" : "wb");
+    if (fp == NULL) {
+        secret_output_failed = 1;
+        close(fd);
+        return NULL;
+    }
+    bio = BIO_new_fp(fp, BIO_CLOSE | (FMT_istext(format) ? BIO_FP_TEXT : 0));
+    if (bio == NULL) {
+        secret_output_failed = 1;
+        fclose(fp);
+    } else {
+        BIO_set_callback_ex(bio, peios_secret_callback);
+    }
+    return bio;
+#else
+    return bio_open_default(filename, mode, format);
+#endif
+}
