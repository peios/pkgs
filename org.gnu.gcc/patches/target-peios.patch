+
+/* Peios is the Linux kernel ABI plus a glibc userland, so every predefine the
+   generic GNU/Linux configuration makes is correct here and is kept:
+   __linux__, __unix__, and __gnu_linux__ (that last one gated on
+   OPTION_GLIBC, which Peios satisfies).  This header only ADDS __peios__,
+   exactly the way linux-android.h adds __ANDROID__ on top of the same base.
+
+   Both answers are wanted.  "Is this Linux?" must stay yes, or every piece of
+   Linux software would need teaching about Peios.  "Is this Peios?" must be
+   answerable too, because parts of the system are unreachable without
+   knowing: the registry and KACS are exposed only through dedicated system
+   calls, so nothing can feel its way to them at compile time.
+
+   __peios__ deliberately carries no version.  The Peios kernel ABI moves on
+   its own scale, independent of the Linux base, so encoding a version here
+   would mean rebuilding the compiler whenever that ABI changed; the pkm
+   headers answer "which Peios", this answers "is it Peios".
+
+   TARGET_OS_CPP_BUILTINS is redefined rather than extended because the
+   preprocessor cannot append to a macro.  The two calls below reproduce
+   i386/linux-common.h, which is where this target's definition comes from; a
+   future non-x86 Peios port needs the equivalent in its own configuration.  */
+
+#undef  TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      GNU_USER_TARGET_OS_CPP_BUILTINS();	\
+      ANDROID_TARGET_OS_CPP_BUILTINS();		\
+      builtin_define ("__peios__");		\
+    }						\
+  while (0)
