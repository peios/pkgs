+/*
+ * Peios: stamp an explicit Security Descriptor on the root directory (and
+ * lost+found) at format time. The OS rootfs gets a deterministic SD rather
+ * than one synthesised at mount; foreign/removable media still rely on
+ * mount-time synthesis. The SD is given as SDDL (-E root_sddl= inline, or
+ * -E root_sd_file= for a file whose contents may contain commas) and parsed
+ * to the binary wire form via libpeios, then written to the canonical
+ * security.peios.sd xattr by direct libext2fs manipulation (which bypasses
+ * the host VFS/LSM and the kernel SD-xattr seal alike).
+ */
+static void set_root_sd_from_sddl(const char *sddl)
+{
+	ssize_t n = peios_sddl_parse_sd(NULL, 0, sddl);
+
+	if (n < 0) {
+		fprintf(stderr, _("Invalid root SDDL: '%s'\n"), sddl);
+		exit(1);
+	}
+	free(root_sd);
+	root_sd = malloc(n);
+	if (!root_sd) {
+		fprintf(stderr, "%s",
+			_("Couldn't allocate memory for root security descriptor\n"));
+		exit(1);
+	}
+	if (peios_sddl_parse_sd(root_sd, n, sddl) != n) {
+		fprintf(stderr, _("Failed to parse root SDDL: '%s'\n"), sddl);
+		exit(1);
+	}
+	root_sd_len = (size_t) n;
+}
+
+static void set_root_sd_from_file(const char *path)
+{
+	FILE	*fp;
+	long	sz;
+	char	*txt;
+
+	fp = fopen(path, "r");
+	if (!fp) {
+		fprintf(stderr, _("Cannot open root_sd_file '%s': %s\n"),
+			path, strerror(errno));
+		exit(1);
+	}
+	if (fseek(fp, 0, SEEK_END) != 0 || (sz = ftell(fp)) < 0 ||
+	    fseek(fp, 0, SEEK_SET) != 0) {
+		fprintf(stderr, _("Cannot size root_sd_file '%s'\n"), path);
+		exit(1);
+	}
+	txt = malloc((size_t) sz + 1);
+	if (!txt) {
+		fprintf(stderr, "%s", _("Couldn't allocate memory\n"));
+		exit(1);
+	}
+	if (fread(txt, 1, (size_t) sz, fp) != (size_t) sz) {
+		fprintf(stderr, _("Cannot read root_sd_file '%s'\n"), path);
+		exit(1);
+	}
+	fclose(fp);
+	txt[sz] = 0;
+	/* Trim trailing newline(s) so a one-line SDDL file parses cleanly. */
+	while (sz > 0 && (txt[sz - 1] == '\n' || txt[sz - 1] == '\r'))
+		txt[--sz] = 0;
+	set_root_sd_from_sddl(txt);
+	free(txt);
+}
+
+static void stamp_root_sd(ext2_filsys fs, ext2_ino_t ino)
+{
+	struct ext2_xattr_handle	*h;
+	errcode_t			retval;
+
+	if (!root_sd)
+		return;
+
+	retval = ext2fs_xattrs_open(fs, ino, &h);
+	if (retval) {
+		com_err("ext2fs_xattrs_open", retval,
+			_("while opening inode %u to set its security descriptor"),
+			ino);
+		exit(1);
+	}
+	retval = ext2fs_xattrs_read(h);
+	if (retval) {
+		com_err("ext2fs_xattrs_read", retval,
+			_("while reading xattrs of inode %u"), ino);
+		exit(1);
+	}
+	retval = ext2fs_xattr_set(h, "security.peios.sd", root_sd, root_sd_len);
+	if (retval) {
+		com_err("ext2fs_xattr_set", retval,
+			_("while setting security descriptor on inode %u"), ino);
+		exit(1);
+	}
+	retval = ext2fs_xattrs_close(&h);
+	if (retval) {
+		com_err("ext2fs_xattrs_close", retval,
+			_("while closing inode %u"), ino);
+		exit(1);
+	}
+}
