+/*
+ * Peios: SD-aware population for `-d`. Compute this inode's Security Descriptor
+ * by reinheriting from its parent in the NEW filesystem, using the source node's
+ * explicit (creator) SD as the base. The source carries that explicit SD in the
+ * user.peios.sd xattr — the portable staging carrier: security.peios.sd is sealed
+ * on a live Peios fs and needs CAP_SYS_ADMIN on a Linux build host, user.* is
+ * neither. The populate walk is top-down, so the parent's security.peios.sd is
+ * already written. peios_sd_reinherit() is pure userspace (no live KACS), so this
+ * works offline on any host; the result is written to the canonical
+ * security.peios.sd by direct libext2fs manipulation, bypassing the host VFS/LSM
+ * and the kernel SD seal alike.
+ */
+static errcode_t set_inode_sd(ext2_filsys fs, ext2_ino_t ino,
+			      ext2_ino_t parent_ino, const char *filename,
+			      int is_container)
+{
+	errcode_t			retval, cret;
+	struct ext2_xattr_handle	*h = NULL;
+	void				*pval = NULL, *parent_sd = NULL;
+	void				*child = NULL, *newsd = NULL;
+	size_t				parent_len = 0;
+	ssize_t				child_len, n;
+
+	/* 1. The source node's explicit/creator SD (out-of-band carrier). */
+	child_len = lgetxattr(filename, "user.peios.sd", NULL, 0);
+	if (child_len <= 0)
+		return 0;		/* nothing staged for this node */
+	retval = ext2fs_get_mem(child_len, &child);
+	if (retval)
+		return retval;
+	if (lgetxattr(filename, "user.peios.sd", child, child_len) != child_len) {
+		ext2fs_free_mem(&child);
+		return 0;
+	}
+
+	/* 2. Parent's SD from the new image; copy it out, then close. */
+	retval = ext2fs_xattrs_open(fs, parent_ino, &h);
+	if (retval) {
+		ext2fs_free_mem(&child);
+		return (retval == EXT2_ET_MISSING_EA_FEATURE) ? 0 : retval;
+	}
+	retval = ext2fs_xattrs_read(h);
+	if (!retval &&
+	    ext2fs_xattr_get(h, "security.peios.sd", &pval, &parent_len) == 0) {
+		retval = ext2fs_get_mem(parent_len, &parent_sd);
+		if (!retval)
+			memcpy(parent_sd, pval, parent_len);
+		ext2fs_free_mem(&pval);
+	}
+	cret = ext2fs_xattrs_close(&h);
+	if (!retval)
+		retval = cret;
+	if (retval)
+		goto out;
+
+	/* 3. With a parent SD, reinherit; else use the explicit SD verbatim. */
+	if (parent_sd) {
+		n = peios_sd_reinherit(NULL, 0, parent_sd, parent_len,
+				       child, child_len, is_container);
+		if (n < 0) {
+			retval = EINVAL;
+			goto out;
+		}
+		retval = ext2fs_get_mem(n, &newsd);
+		if (retval)
+			goto out;
+		if (peios_sd_reinherit(newsd, n, parent_sd, parent_len,
+				       child, child_len, is_container) != n) {
+			retval = EINVAL;
+			goto out;
+		}
+	} else {
+		n = child_len;
+		retval = ext2fs_get_mem(n, &newsd);
+		if (retval)
+			goto out;
+		memcpy(newsd, child, n);
+	}
+
+	/* 4. Write security.peios.sd onto the child inode. */
+	retval = ext2fs_xattrs_open(fs, ino, &h);
+	if (retval) {
+		if (retval == EXT2_ET_MISSING_EA_FEATURE)
+			retval = 0;
+		goto out;
+	}
+	retval = ext2fs_xattrs_read(h);
+	if (retval)
+		goto out;
+	retval = ext2fs_xattr_set(h, "security.peios.sd", newsd, n);
+out:
+	if (h) {
+		cret = ext2fs_xattrs_close(&h);
+		if (!retval)
+			retval = cret;
+	}
+	ext2fs_free_mem(&parent_sd);
+	ext2fs_free_mem(&child);
+	ext2fs_free_mem(&newsd);
+	return retval;
+}
