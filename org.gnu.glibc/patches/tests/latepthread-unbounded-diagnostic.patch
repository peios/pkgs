Description: Capture the complete loader diagnostic in the late-pthread test
Author: Peios maintainers
Origin: vendor
Forwarded: no
Last-Update: 2026-09-16

The loader prints two absolute build paths before the missing symbol. A
512-byte fixed buffer truncates the expected symbol in long workspaces.
Use glibc's existing subprocess capture helper, which drains both pipes and
retains the full diagnostic. Keep the same missing-symbol and exit-127 checks.
This changes only the test harness, not installed libc behavior.

--- a/elf/tst-latepthread.c
+++ b/elf/tst-latepthread.c
@@ -17,11 +17,21 @@
    <https://www.gnu.org/licenses/>.  */
 
 #include <dlfcn.h>
+#include <support/capture_subprocess.h>
 #include <signal.h>
 #include <stdio.h>
 #include <string.h>
 #include <sys/wait.h>
 #include <unistd.h>
+
+/* Capture the entire loader diagnostic, including long build paths.  */
+static void
+trigger_failure (void *closure)
+{
+  int (*func) (void) = *(int (**)(void)) closure;
+  func ();
+  _exit (3);
+}
 
 static int
 do_test (void)
@@ -40,65 +50,25 @@
     }
   int (*func) (void) = ptr;
 
-  /* Run the actual test in a subprocess, to capture the error.  */
-  int fds[2];
-  if (pipe (fds) < 0)
-    {
-      printf ("error: pipe: %m\n");
-      return 1;
-    }
-  pid_t pid = fork ();
-  if (pid < 0)
-    {
-      printf ("error: fork: %m\n");
-      return 1;
-    }
-  else if (pid == 0)
-    {
-      if (dup2 (fds[1], STDERR_FILENO) < 0)
-        _exit (2);
-      /* Trigger an abort.  */
-      func ();
-      _exit (3);
-    }
-  /* NB: This assumes that the abort message is so short that the pipe
-     does not block.  */
-  int status;
-  if (waitpid (pid, &status, 0) < 0)
-    {
-      printf ("error: waitpid: %m\n");
-      return 1;
-    }
-
-  /* Check the printed error message.  */
-  if (close (fds[1]) < 0)
-   {
-     printf ("error: close: %m\n");
-     return 1;
-   }
-  char buf[512];
-  /* Leave room for the NUL terminator.  */
-  ssize_t ret = read (fds[0], buf, sizeof (buf) - 1);
-  if (ret < 0)
-    {
-      printf ("error: read: %m\n");
-      return 1;
-    }
-  if (ret > 0 && buf[ret - 1] == '\n')
-    --ret;
-  buf[ret] = '\0';
-  printf ("info: exit status: %d, message: %s\n", status, buf);
-  if (strstr (buf, "undefined symbol: this_function_is_not_defined") == NULL)
+  /* Drain output while waiting, without truncating paths or filling a pipe.  */
+  struct support_capture_subprocess result
+    = support_capture_subprocess (trigger_failure, &func);
+  int status = result.status;
+  int failed = 0;
+  printf ("info: exit status: %d, message: %s\n", status, result.err.buffer);
+  if (strstr (result.err.buffer,
+              "undefined symbol: this_function_is_not_defined") == NULL)
     {
       printf ("error: message does not contain expected string\n");
-      return 1;
+      failed = 1;
     }
   if (!WIFEXITED (status) || WEXITSTATUS (status) != 127)
     {
       printf ("error: unexpected process exit status\n");
-      return 1;
+      failed = 1;
     }
-  return 0;
+  support_capture_subprocess_free (&result);
+  return failed;
 }
 
 #include <support/test-driver.c>
