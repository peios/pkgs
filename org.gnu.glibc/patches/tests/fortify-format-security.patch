From: Peios Packaging <packages@peios.dev>
Subject: [PATCH] debug: pair intentional -Wno-format with format-security exemption

The fortify tests deliberately compile format strings which provoke warnings,
so their harness already uses -Wno-format and -Wno-error.  Peios's workspace
flags contain the more-specific -Werror=format-security; GCC correctly leaves
that diagnostic enabled despite the general -Wno-error and then rejects the
intentional -Wno-format combination before the tests run.

Disable only that dependent error for the direct and generated fortify test
objects.  Production libc objects retain -Werror=format-security.
---
 debug/Makefile | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/debug/Makefile b/debug/Makefile
index 48efdaa41d..c9be8ea070 100644
--- a/debug/Makefile
+++ b/debug/Makefile
@@ -213,6 +213,7 @@ tests-c-time64-chk =
 tests-cc-time64-chk =
 
 CFLAGS-tst-fortify.c += -Wno-format -Wno-deprecated-declarations -Wno-error
+CFLAGS-tst-fortify.c += -Wno-error=format-security
 
 # No additional flags for the default tests.
 define cflags-default
@@ -240,6 +241,7 @@ CFLAGS-tst-fortify-$(1)-$(2)-$(3)-$(4).$(1) += $(no-fortify-source) -D_FORTIFY_
 					  -Wno-format \
 					  -Wno-deprecated-declarations \
 					  -Wno-error
+CFLAGS-tst-fortify-$(1)-$(2)-$(3)-$(4).$(1) += -Wno-error=format-security
 $(eval $(call cflags-$(2),$(1),$(3),$(4)))
 $(objpfx)tst-fortify-$(1)-$(2)-$(3)-$(4).$(1): tst-fortify.c Makefile
 	( echo "/* Autogenerated from Makefile.  */"; \
-- 
