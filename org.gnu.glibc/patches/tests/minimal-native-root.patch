From: Peios Package Maintainers <packages@peios.dev>
Subject: [PATCH] tests: retain coverage in accountless user namespaces

Peios build roots deliberately carry no /etc/passwd and run in a single-ID
user namespace. Keep the affected tests meaningful without adding blanket
UNSUPPORTED exclusions:

* rtld's missing-program checks may inherit ENOENT from a deliberately empty
  sysfs, but must still emit their exact one-line diagnostics and exit 127;
* globtest only needs a numeric root check for its unreadable-directory cases;
* tst-bug24963 needs an inert stream, whose contents it explicitly ignores;
* tst-setuid3 must accept EINVAL when uid 0 is unmapped in the current user
  namespace, while still exercising both pre- and post-thread setxid paths.
---
diff --git a/elf/tst-rtld-dash-dash.sh b/elf/tst-rtld-dash-dash.sh
index 24b8d5ab03..704dcc10d4 100755
--- a/elf/tst-rtld-dash-dash.sh
+++ b/elf/tst-rtld-dash-dash.sh
@@ -31,7 +31,10 @@ echo "output (with expected error):"
 cat "$tmp_out"
 
+# An empty sysfs can leave a harmless ENOENT from rtld's THP probe.
 if test $status -eq 127 \
-	&& grep -q "^--program-does-not-exist: error while loading shared libraries: --program-does-not-exist: cannot open shared object file$" "$tmp_out" \
+	&& grep -Eq \
+	"^--program-does-not-exist: error while loading shared libraries: --program-does-not-exist: cannot open shared object file(: No such file or directory)?$" \
+	"$tmp_out" \
 	&& test "$(wc -l < "$tmp_out")" -eq 1 ; then
     status=0
 else
diff --git a/elf/tst-rtld-does-not-exist.sh b/elf/tst-rtld-does-not-exist.sh
index ed325a8380..8f9fb9c476 100755
--- a/elf/tst-rtld-does-not-exist.sh
+++ b/elf/tst-rtld-does-not-exist.sh
@@ -31,7 +31,10 @@ echo "output (with expected error):"
 cat "$tmp_out"
 
+# An empty sysfs can leave a harmless ENOENT from rtld's THP probe.
 if test $status -eq 127 \
-	&& grep -q "^program-does-not-exist: error while loading shared libraries: program-does-not-exist: cannot open shared object file$" "$tmp_out" \
+	&& grep -Eq \
+	"^program-does-not-exist: error while loading shared libraries: program-does-not-exist: cannot open shared object file(: No such file or directory)?$" \
+	"$tmp_out" \
 	&& test "$(wc -l < "$tmp_out")" -eq 1 ; then
     status=0
 else
diff --git a/posix/globtest.sh b/posix/globtest.sh
index 53aee98426..0b35dce2c1 100755
--- a/posix/globtest.sh
+++ b/posix/globtest.sh
@@ -631,11 +631,9 @@ if test $failed -ne 0; then
 fi
 
 # The following tests will fail if run as root.
-user=`id -un 2> /dev/null`
-if test -z "$user"; then
-    uid="$USER"
-fi
-if test "$user" != root; then
+# A numeric check also works in accountless build roots where the current UID
+# deliberately has no passwd-database record.
+if test "`id -u`" != 0; then
     # ... with GLOB_ERR
     ${test_program_prefix} \
     ${common_objpfx}posix/globtest -E "$testdir" "noread/*" |
diff --git a/sysdeps/pthread/tst-bug24963.c b/sysdeps/pthread/tst-bug24963.c
index a5688e5c25..7dc826e76d 100644
--- a/sysdeps/pthread/tst-bug24963.c
+++ b/sysdeps/pthread/tst-bug24963.c
@@ -27,6 +27,9 @@
 
 static _Atomic bool running = true;
 
+/* The test ignores stream contents; /dev/null also exists without passwd.  */
+static const char test_file[] = "/dev/null";
+
 static void *
 fflush_thread (void *ignored)
 {
@@ -49,7 +52,7 @@ fopen_thread (void *ignored)
 {
   while (running)
     {
-      FILE *fp = xfopen ("/etc/passwd", "r");
+      FILE *fp = xfopen (test_file, "r");
       (void) fgetc (fp);
       xfclose (fp);
     }
@@ -62,7 +65,7 @@ freopen_thread (void *fp)
   while (running)
     {
       uintptr_t old_address = (uintptr_t) fp;
-      FILE *fpnew = xfreopen ("/etc/passwd", "r", fp);
+      FILE *fpnew = xfreopen (test_file, "r", fp);
       TEST_COMPARE (old_address, (uintptr_t) fpnew);
     }
   return NULL;
@@ -81,7 +84,7 @@ do_test (void)
   pthread_t freopens[array_length (fps)];
   for (int i = 0; i < array_length(fps); ++i)
     {
-      fps[i] = xfopen ("/etc/passwd", "r");
+      fps[i] = xfopen (test_file, "r");
       freopens[i] = xpthread_create (NULL, freopen_thread, fps[i]);
     }
 
diff --git a/sysdeps/pthread/tst-setuid3.c b/sysdeps/pthread/tst-setuid3.c
index 774b3ea495..7159f1eace 100644
--- a/sysdeps/pthread/tst-setuid3.c
+++ b/sysdeps/pthread/tst-setuid3.c
@@ -53,7 +53,10 @@ setuid_failure (int phase)
     case 0:
       FAIL_EXIT1 ("setuid succeeded unexpectedly in phase %d", phase);
     case -1:
-      if (errno != EPERM)
+      /* EINVAL is specified when the target UID is not mapped in the current
+         user namespace. Single-ID sandboxes still exercise the same setxid
+         failure propagation.  */
+      if (errno != EPERM && errno != EINVAL)
 	FAIL_EXIT1 ("setuid phase %d: %m", phase);
       break;
     default:
