 \`~/dir3\\*/file2'
 EOF
-if eval test -d ~"$USER"/; then
+if test "${PEIOS_ACCOUNTLESS_GLOB_TEST:-0}" != 1 && eval test -d ~"$USER"/; then
   user=`echo "$USER" | sed -n -e 's/^\([^\\]\)\([^\\][^\\]*\)$/~\1\\\\\2/p'`
   if test -n "$user"; then
