   {
-   [nss_database_group] = nss_database_default_compat,
-   [nss_database_group_compat] = nss_database_default_nis,
-   [nss_database_gshadow] = nss_database_default_files,
+   [nss_database_group] = nss_database_default_peios,
+   [nss_database_group_compat] = nss_database_default_none,
+   [nss_database_gshadow] = nss_database_default_none,
-   [nss_database_hosts] = nss_database_default_dns,
+   [nss_database_hosts] = nss_database_default_peios_net,
