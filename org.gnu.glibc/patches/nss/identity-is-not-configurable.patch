+/* Peios: true for a database whose service list is fixed by policy above.  */
+static bool
+nss_database_is_peios_fixed (enum nss_database db)
+{
+  switch (db)
+    {
+    case nss_database_group:
+    case nss_database_group_compat:
+    case nss_database_gshadow:
+    case nss_database_initgroups:
+    case nss_database_passwd:
+    case nss_database_passwd_compat:
+    case nss_database_publickey:
+    case nss_database_shadow:
+    case nss_database_shadow_compat:
+    case nss_database_hosts:
+      return true;
+    default:
+      return false;
+    }
+}
