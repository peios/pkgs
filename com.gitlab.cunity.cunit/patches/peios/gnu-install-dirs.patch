Description: Install CUnit to the platform's standard directories
 Upstream's CMake install puts the static library in <prefix>/lib and its
 CMake package files in <prefix>/CUnit/share/cmake, whose CUnitConfig.cmake
 then finds the headers three directories up. Use GNUInstallDirs for the
 library, headers and CMake package (<libdir>/cmake/CUnit), take the include
 directory from the exported target instead of a relative path, and install
 the pkg-config module and the XML report DTD/XSL files that the historic
 Autotools build installed, so consumers probing `cunit` with pkg-config or
 meson's dependency('cunit') find it.
Author: Peios maintainers <packaging@peios.org>
Origin: vendor
Forwarded: no

--- a/CUnit/CMakeLists.txt
+++ b/CUnit/CMakeLists.txt
@@ -99,8 +99,24 @@
 endif()
 
 if(CUNIT_CMAKE_INSTALL STREQUAL yes)
-  install(DIRECTORY CUnit/ DESTINATION include/CUnit)
-  install(TARGETS cunit DESTINATION lib EXPORT cunit-targets)
-  install(EXPORT cunit-targets DESTINATION CUnit/share/cmake FILE CUnitTargets.cmake)
-  install(FILES CUnitConfig.cmake DESTINATION CUnit/share/cmake)
+  include(GNUInstallDirs)
+  install(DIRECTORY CUnit/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/CUnit
+    FILES_MATCHING PATTERN "*.h")
+  install(TARGETS cunit DESTINATION ${CMAKE_INSTALL_LIBDIR} EXPORT cunit-targets)
+  install(EXPORT cunit-targets DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/CUnit
+    FILE CUnitTargets.cmake)
+  install(FILES CUnitConfig.cmake DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/CUnit)
+  set(CUNIT_PC_LIBDIR "${CMAKE_INSTALL_FULL_LIBDIR}")
+  set(CUNIT_PC_INCLUDEDIR "${CMAKE_INSTALL_FULL_INCLUDEDIR}")
+  configure_file(cunit.pc.cmake ${CMAKE_CURRENT_BINARY_DIR}/cunit.pc @ONLY)
+  install(FILES ${CMAKE_CURRENT_BINARY_DIR}/cunit.pc
+    DESTINATION ${CMAKE_INSTALL_LIBDIR}/pkgconfig)
+  install(FILES
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/CUnit-List.dtd
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/CUnit-List.xsl
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/CUnit-Run.dtd
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/CUnit-Run.xsl
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/Memory-Dump.dtd
+    ${CMAKE_CURRENT_LIST_DIR}/../Share/Memory-Dump.xsl
+    DESTINATION ${CMAKE_INSTALL_DATADIR}/CUnit)
 endif()
--- a/CUnit/CUnitConfig.cmake
+++ b/CUnit/CUnitConfig.cmake
@@ -1,4 +1,3 @@
+include(${CMAKE_CURRENT_LIST_DIR}/CUnitTargets.cmake)
 set (CUNIT_LIBRARIES cunit)
-set (CUNIT_INCLUDE_DIRS ${CMAKE_CURRENT_LIST_DIR}/../../../include)
-
-include(${CMAKE_CURRENT_LIST_DIR}/CUnitTargets.cmake)
\ No newline at end of file
+get_target_property(CUNIT_INCLUDE_DIRS cunit INTERFACE_INCLUDE_DIRECTORIES)
--- a/CUnit/cunit.pc.cmake
+++ b/CUnit/cunit.pc.cmake
@@ -0,0 +1,8 @@
+libdir=@CUNIT_PC_LIBDIR@
+includedir=@CUNIT_PC_INCLUDEDIR@
+
+Name: CUnit
+Description: C Unit Testing Framework
+Version: @CUNIT_VERSION@
+Libs: -L${libdir} -lcunit
+Cflags: -I${includedir}
