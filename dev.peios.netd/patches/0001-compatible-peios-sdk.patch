Subject: [PATCH] build: accept compatible rolling Peios SDK releases
Origin: other, Peios catalogue qualification review
Upstream-Status: Pending [keep API floor and SONAME contract instead of patch-version locks]

The consumer requires the released peios API from 0.5.0 and SONAME 0.
Validate both at build and test time while allowing compatible newer releases.
Bindgen uses the libclang C API; retain its supported LLVM 22.1.8 minimum
without an unsubstantiated LLVM 23 exclusion. Fresh native qualification
against the selected SDK remains required.

--- a/pekit.toml
+++ b/pekit.toml
@@ -64,10 +64,12 @@
 # Native releases consume the qualified packaged ABI and generated kernel
 # headers. Sibling libpeios, peios-rs, and PKM checkouts are never consulted.
 unset PEIOS_LIB_DIR PEIOS_INCLUDE PKM_UAPI
-test "$(pkg-config --modversion peios)" = 0.5.0 || {
-  echo "netd: dev.peios.libpeios-devel 0.5.0 is required" >&2
+pkg-config --atleast-version=0.5.0 peios || {
+  echo "netd: dev.peios.libpeios-devel >= 0.5.0 (ABI 0) is required" >&2
   exit 1
 }
+# A newer compatible release is valid; a different C ABI is not.
+readelf -dW "$(pkg-config --variable=libdir peios)/libpeios.so" | grep -Eq '\(SONAME\).*\[libpeios\.so\.0\]'
 export BINDGEN_EXTRA_CLANG_ARGS="-isystem $(gcc -print-file-name=include) ${BINDGEN_EXTRA_CLANG_ARGS:-}"
 
 cargo metadata --locked --offline --no-deps --format-version 1 |
@@ -170,9 +172,9 @@
 "org.gnu.binutils"         = "*"
 "org.sourceware.debugedit" = "*"
 "org.python.python3"       = "*"
-"org.llvm.clang-devel"     = ">= 22, < 23"
+"org.llvm.clang-devel"     = ">= 22.1.8"
 "org.pkgconf.pkgconf"      = "*"
-"dev.peios.libpeios-devel" = "= 0.5.0-1"
+"dev.peios.libpeios-devel" = ">= 0.5.0"
 
 [build.main.dependencies.apt]
 dash            = "*"
@@ -201,7 +203,9 @@
 mkdir -p "$CARGO_HOME"
 cp "$PEKIT_VENDOR_OUT/cargo-config.toml" "$CARGO_HOME/config.toml"
 unset PEIOS_LIB_DIR PEIOS_INCLUDE PKM_UAPI
-test "$(pkg-config --modversion peios)" = 0.5.0
+pkg-config --atleast-version=0.5.0 peios
+# A newer compatible release is valid; a different C ABI is not.
+readelf -dW "$(pkg-config --variable=libdir peios)/libpeios.so" | grep -Eq '\(SONAME\).*\[libpeios\.so\.0\]'
 export BINDGEN_EXTRA_CLANG_ARGS="-isystem $(gcc -print-file-name=include) ${BINDGEN_EXTRA_CLANG_ARGS:-}"
 cargo test --release --workspace --locked --offline --target-dir "$PEKIT_OUT/tests"
 
@@ -307,9 +311,9 @@
 "org.gnu.binutils"         = "*"
 "org.sourceware.debugedit" = "*"
 "org.python.python3"       = "*"
-"org.llvm.clang-devel"     = ">= 22, < 23"
+"org.llvm.clang-devel"     = ">= 22.1.8"
 "org.pkgconf.pkgconf"      = "*"
-"dev.peios.libpeios-devel" = "= 0.5.0-1"
+"dev.peios.libpeios-devel" = ">= 0.5.0"
 
 [test.dependencies.apt]
 dash            = "*"
