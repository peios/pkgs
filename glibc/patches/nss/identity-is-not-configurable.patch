+/* Peios: the identity databases.
+
+   On Peios a principal is not a line in a file.  Identity comes from the
+   authentication authority, which resolves a name across the principal sources
+   it is configured to have, in a configured order, applying the domain and
+   numeric confinement that keeps one source from answering for another.  None
+   of that is expressible in nsswitch.conf, and a second search order that the
+   authority cannot see is a second answer to "who is jack" -- which is how a
+   program comes to act for one principal while its access is checked against
+   another.
+
+   So these databases are not configurable.  Their lines in nsswitch.conf are
+   discarded (see nss_database_reload) and these defaults are the only possible
+   answer.  Adding a source of identity to a Peios machine means writing a
+   principal source, which is a separate process the authority confines -- not
+   an object injected into every address space on the system.
+
+   There is no "files" fallback because there is no /etc/passwd.  uid 0 is a
+   projection of the SYSTEM token rather than an account, and nothing on the
+   system resolves a name in order to find it.  Before the authority is running,
+   identity does not resolve at all, which is the honest answer rather than a
+   gap to paper over.
+
+   shadow and gshadow are empty rather than routed: a Peios verifier lives in
+   its source's store and cannot be read out, so there is no entry to return.  */
+
 /* Databases not listed default to nss_database_default_defconfig.  */
 static const char per_database_defaults[NSS_DATABASE_COUNT] =
   {
-   [nss_database_group] = nss_database_default_compat,
-   [nss_database_group_compat] = nss_database_default_nis,
-   [nss_database_gshadow] = nss_database_default_files,
+   [nss_database_group] = nss_database_default_peios,
+   [nss_database_group_compat] = nss_database_default_none,
+   [nss_database_gshadow] = nss_database_default_none,
    [nss_database_hosts] = nss_database_default_dns,
-   [nss_database_initgroups] = nss_database_default_none,
+   [nss_database_initgroups] = nss_database_default_peios,
    [nss_database_networks] = nss_database_default_dns,
-   [nss_database_passwd] = nss_database_default_compat,
-   [nss_database_passwd_compat] = nss_database_default_nis,
+   [nss_database_passwd] = nss_database_default_peios,
+   [nss_database_passwd_compat] = nss_database_default_none,
    [nss_database_publickey] = nss_database_default_nis_nisplus,
-   [nss_database_shadow] = nss_database_default_compat,
-   [nss_database_shadow_compat] = nss_database_default_nis,
+   [nss_database_shadow] = nss_database_default_none,
+   [nss_database_shadow_compat] = nss_database_default_none,
   };
 
+/* Peios: true for a database whose service list is fixed above.  */
+static bool
+nss_database_is_identity (enum nss_database db)
+{
+  switch (db)
+    {
+    case nss_database_group:
+    case nss_database_group_compat:
+    case nss_database_gshadow:
+    case nss_database_initgroups:
+    case nss_database_passwd:
+    case nss_database_passwd_compat:
+    case nss_database_shadow:
+    case nss_database_shadow_compat:
+      return true;
+    default:
+      return false;
+    }
+}
