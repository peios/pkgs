Subject: [PATCH] package: ship resolver manuals and homepage metadata
Origin: other, Peios packaging qualification
Upstream-Status: Pending

--- a/pekit.toml
+++ b/pekit.toml
@@ -139,6 +139,18 @@
   "$PEKIT_OUT/usr/share/regim/resolvd-port.reg"
 install -m 0644 "$SRC/resolvd.regman" \
   "$PEKIT_OUT/usr/share/regman/resolvd.regman"
+
+python3 - "$SRC" "$PEKIT_OUT" <<'PY_MAN'
+import gzip, os, pathlib, sys
+source, output = map(pathlib.Path, sys.argv[1:])
+for name, section in (("resolvd", "8"), ("resolv", "1")):
+    target = output / "usr/share/man" / ("man" + section) / (name + "." + section + ".gz")
+    target.parent.mkdir(parents=True, exist_ok=True)
+    with target.open("wb") as raw:
+        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as stream:
+            stream.write((source / "man" / (name + "." + section)).read_bytes())
+    os.chmod(target, 0o644)
+PY_MAN
 
 : > "$PEKIT_OUT/.debug-sources"
 split_debug() {
@@ -242,6 +254,15 @@
 # Validate the exact staged package output produced by build.main.
 SRC=$(pwd -P)
 PEKIT_OUT="$PEKIT_MAIN_OUT"
+python3 - "$SRC" "$PEKIT_OUT" <<'PY_MAN'
+import gzip, pathlib, sys
+source, output = map(pathlib.Path, sys.argv[1:])
+for name, section in (("resolvd", "8"), ("resolv", "1")):
+    raw = (output / "usr/share/man" / ("man" + section) / (name + "." + section + ".gz")).read_bytes()
+    data = (source / "man" / (name + "." + section)).read_bytes()
+    assert raw[4:8] == bytes(4)
+    assert gzip.decompress(raw) == data
+PY_MAN
 test "$("$PEKIT_OUT/usr/bin/resolv" version)" = "resolv $PEKIT_VERSION"
 python3 - "$PEKIT_OUT" <<'PY'
 import json, pathlib, sys
