--- /dev/null
+++ b/Lib/test/support/peios_libc_prerequisites.c
@@ -0,0 +1,90 @@
+#define _GNU_SOURCE
+#include <arpa/inet.h>
+#include <errno.h>
+#include <grp.h>
+#include <netdb.h>
+#include <pwd.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+#include <dlfcn.h>
+
+static int missing_resolver_bridge(void) {
+    /* The native glibc contract fixes hosts to peios_net. This particular
+       offline root has neither its NSS bridge nor the authority endpoint.
+       Require all three independent absence checks for the loader-error case. */
+    errno = 0;
+    void *bridge = dlopen("libnss_peios_net.so.2", RTLD_NOW | RTLD_LOCAL);
+    int loader_error = errno;
+    if (bridge) { dlclose(bridge); return 0; }
+    const char *loader_message = dlerror();
+    printf("NSS bridge loader errno=%d error=%s\n", loader_error,
+           loader_message ? loader_message : "(none)");
+    errno = 0;
+    int module_missing = access("/usr/lib/x86_64-linux-peios/libnss_peios_net.so.2", F_OK) < 0 && errno == ENOENT;
+    errno = 0;
+    int endpoint_missing = access("/run/resolvd/resolv.sock", F_OK) < 0 && errno == ENOENT;
+    printf("NSS bridge path missing=%d resolver endpoint missing=%d\n", module_missing, endpoint_missing);
+    return loader_message != NULL
+        && strcmp(loader_message, "libnss_peios_net.so.2: cannot open shared object file: No such file or directory") == 0
+        && module_missing && endpoint_missing;
+}
+
+int main(int argc, char **argv) {
+    if (argc < 2) return 2;
+    errno = 0;
+    if (!strcmp(argv[1], "hostname")) {
+        struct addrinfo *result = NULL;
+        struct addrinfo hints = {0};
+        int status = getaddrinfo("localhost", "0", &hints, &result);
+        int error = errno;
+        printf("getaddrinfo status=%d errno=%d\n", status, error);
+        if (!status) { freeaddrinfo(result); return 0; }
+        if (status == EAI_NONAME || status == EAI_NODATA) return 77;
+        if (status == EAI_SYSTEM && error == EBUSY && missing_resolver_bridge()) return 77;
+        return 1;
+    }
+    if (!strcmp(argv[1], "reverse")) {
+        struct in_addr address;
+        if (inet_pton(AF_INET, "127.0.0.1", &address) != 1) return 1;
+        struct hostent *result = gethostbyaddr(&address, sizeof(address), AF_INET);
+        int error = errno, host_error = h_errno;
+        printf("gethostbyaddr available=%d h_errno=%d errno=%d\n", result != NULL, host_error, error);
+        if (result) return 0;
+        if (host_error == HOST_NOT_FOUND || host_error == NO_DATA) return 77;
+        if (host_error == NO_RECOVERY && error == ENOENT && missing_resolver_bridge()) return 77;
+        return 1;
+    }
+    if (!strcmp(argv[1], "passwd") && argc == 3) {
+        struct passwd *result = getpwuid((uid_t)strtoul(argv[2], NULL, 10));
+        int error = errno;
+        printf("getpwuid available=%d errno=%d\n", result != NULL, error);
+        if (result) return 0;
+        return error == 0 || error == ENOENT || error == ESRCH ? 77 : 1;
+    }
+    if (!strcmp(argv[1], "group") && argc == 3) {
+        struct group *result = getgrgid((gid_t)strtoul(argv[2], NULL, 10));
+        int error = errno;
+        printf("getgrgid available=%d errno=%d\n", result != NULL, error);
+        if (result) return 0;
+        return error == 0 || error == ENOENT || error == ESRCH ? 77 : 1;
+    }
+    if (!strcmp(argv[1], "cgi")) {
+        struct passwd *result = getpwnam("nobody");
+        int error = errno;
+        printf("getpwnam nobody available=%d errno=%d\n", result != NULL, error);
+        if (result) return 0;
+        if (error != 0 && error != ENOENT && error != ESRCH) return 1;
+        errno = 0;
+        setpwent();
+        result = getpwent();
+        error = errno;
+        printf("getpwent available=%d errno=%d\n", result != NULL, error);
+        endpwent();
+        if (result) return 0;
+        return error == 0 || error == ENOENT || error == ESRCH ? 77 : 1;
+    }
+    return 2;
+}
