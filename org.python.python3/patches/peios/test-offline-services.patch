--- /dev/null
+++ b/Lib/test/support/_peios_prerequisites.py
@@ -0,0 +1,25 @@
+"""Independent libc controls for Peios offline package-test prerequisites."""
+import os
+import subprocess
+import unittest
+
+# Some upstream cases deliberately clear the environment. Capture policy and
+# the compiled control path before they do so; never infer absence from Python.
+NATIVE_WORKER = os.environ.get("PEKIT_NATIVE_ROOT") == "1"
+LIBC_PROBE = os.environ.get("PEKIT_LIBC_PREREQUISITE_PROBE")
+
+
+def require_libc_prerequisite(feature, *args):
+    if not NATIVE_WORKER:
+        return
+    if not LIBC_PROBE or not os.path.isabs(LIBC_PROBE):
+        raise RuntimeError("native test worker is missing its direct-libc control")
+    result = subprocess.run([LIBC_PROBE, feature, *map(str, args)],
+                            capture_output=True, text=True, timeout=10)
+    evidence = (result.stdout + result.stderr).strip()
+    if result.returncode == 77:
+        raise unittest.SkipTest(
+            f"Peios offline worker lacks libc {feature} prerequisite: {evidence}"
+        )
+    if result.returncode != 0:
+        raise RuntimeError(f"libc prerequisite control failed ({result.returncode}): {evidence}")
