Description: Accept the Peios multiarch platform triplet
 Peios's toolchain reports x86_64-linux-peios from --print-multiarch, and
 CPython's configure rejects any multiarch value that differs from its
 glibc-derived x86_64-linux-gnu triplet. Adopt the Peios triplet so configure
 succeeds and SOABI and extension-module suffixes name the Peios ABI, and let
 test_sysconfig accept that suffix.
Author: Peios maintainers <packaging@peios.org>
Origin: vendor
Forwarded: not-needed

--- a/configure
+++ b/configure
@@ -7189,6 +7189,13 @@
 esac
 
 
+# Peios: the toolchain's --print-multiarch answers x86_64-linux-peios; adopt
+# it as the platform triplet instead of failing against the glibc-derived
+# x86_64-linux-gnu default (SOABI then carries the Peios triplet).
+if test x$MULTIARCH = xx86_64-linux-peios; then
+  PLATFORM_TRIPLET=x86_64-linux-peios
+fi
+
 if test x$PLATFORM_TRIPLET != x && test x$MULTIARCH != x; then
   if test x$PLATFORM_TRIPLET != x$MULTIARCH; then
     as_fn_error $? "internal configure error for the platform triplet, please file a bug report" "$LINENO" 5
--- a/configure.ac
+++ b/configure.ac
@@ -1177,6 +1177,12 @@
 )
 AC_SUBST([MULTIARCH])
 
+# Peios: keep the generated configure input in sync with the release script.
+# The toolchain's multiarch answer is the platform ABI name used by SOABI.
+if test x$MULTIARCH = xx86_64-linux-peios; then
+  PLATFORM_TRIPLET=x86_64-linux-peios
+fi
+
 if test x$PLATFORM_TRIPLET != x && test x$MULTIARCH != x; then
   if test x$PLATFORM_TRIPLET != x$MULTIARCH; then
     AC_MSG_ERROR([internal configure error for the platform triplet, please file a bug report])
--- a/Lib/test/test_sysconfig.py
+++ b/Lib/test/test_sysconfig.py
@@ -568,7 +568,8 @@
             if ctypes.sizeof(ctypes.c_char_p()) == 4:
                 expected_suffixes = 'i386-linux-gnu.so', 'x86_64-linux-gnux32.so', 'i386-linux-musl.so'
             else: # 8 byte pointer size
-                expected_suffixes = 'x86_64-linux-gnu.so', 'x86_64-linux-musl.so'
+                expected_suffixes = ('x86_64-linux-gnu.so', 'x86_64-linux-musl.so',
+                                     'x86_64-linux-peios.so')
             self.assertEndsWith(suffix, expected_suffixes)

     @unittest.skipUnless(sys.platform == 'android', 'Android-specific test')
