Description: Require representable Linux user-namespace identities in ownership tests
Origin: vendor, Peios
Forwarded: not-needed; package worker uses a single-ID user namespace

--- a/Lib/test/support/os_helper.py
+++ b/Lib/test/support/os_helper.py
@@ -841,3 +841,20 @@
                     DDD_REMOVE_DEFINITION | DDD_EXACT_MATCH_ON_REMOVE,
                     drive, path):
                 raise ctypes.WinError(ctypes.get_last_error())
+
+
+def require_mapped_id(kind, ident):
+    """Skip an identity-changing test only when Linux cannot represent its ID.
+
+    A single-ID user namespace reports EINVAL, not EPERM, for unmapped IDs.
+    Other permission errors and mapped-ID operations retain upstream assertions.
+    """
+    if kind not in ('uid', 'gid'):
+        raise ValueError(kind)
+    try:
+        with open('/proc/self/' + kind + '_map', encoding='ascii') as stream:
+            ranges = [tuple(map(int, line.split())) for line in stream]
+    except FileNotFoundError:
+        return  # Non-Linux hosts have no Linux user-namespace identity map.
+    if not any(start <= ident < start + count for start, outside, count in ranges):
+        raise unittest.SkipTest(f'{kind} {ident} is outside the Linux user namespace map')
