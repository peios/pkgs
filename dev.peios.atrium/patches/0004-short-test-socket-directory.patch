Subject: [PATCH] test: allocate a short disposable jobs socket directory
Origin: other, Peios catalogue qualification review
Upstream-Status: Pending [AF_UNIX path bound must not depend on campaign checkout length]

Keep the existing jobs client descriptor/pidfd/stop test enabled. Use a private
short directory below /tmp and remove it on success, failure or signal; retain
the existing failure log. Signals terminate the gate after cleanup.

--- a/pekit.toml
+++ b/pekit.toml
@@ -223,14 +223,25 @@
 # Run the complete unit suite against the exact locked dependency graph. The
 # jobs-client test is normally conditional; give it a disposable PSPU jobs
 # endpoint so it exercises descriptor passing, pidfd completion, and stop.
-FAKE_JOBS="$PEKIT_OUT/fake-peinit.sock"
+# sockaddr_un paths have a fixed small bound, independent of campaign paths.
+# Pin the parent to /tmp rather than a potentially long inherited TMPDIR.
+FAKE_DIR=$(mktemp -d /tmp/atrium-jobs.XXXXXXXXXX)
+FAKE_JOBS="$FAKE_DIR/jobs.sock"
+FAKE_PID=
+cleanup_fake() {
+  if [ -n "$FAKE_PID" ]; then
+    kill "$FAKE_PID" 2>/dev/null || true
+    wait "$FAKE_PID" 2>/dev/null || true
+    FAKE_PID=
+  fi
+  rm -rf "$FAKE_DIR"
+}
+trap cleanup_fake EXIT
+trap 'exit 129' HUP
+trap 'exit 130' INT
+trap 'exit 143' TERM
 python3 "$SRC/tools/dev/fake_peinit.py" "$FAKE_JOBS" >"$PEKIT_OUT/fake-peinit.log" 2>&1 &
 FAKE_PID=$!
-cleanup_fake() {
-  kill "$FAKE_PID" 2>/dev/null || true
-  wait "$FAKE_PID" 2>/dev/null || true
-}
-trap cleanup_fake EXIT HUP INT TERM
 i=0
 while [ ! -S "$FAKE_JOBS" ]; do
   kill -0 "$FAKE_PID" 2>/dev/null || {
@@ -248,7 +259,7 @@
   cargo test --release --workspace --locked --offline --target-dir "$PEKIT_OUT/target"
 cleanup_fake
 trap - EXIT HUP INT TERM
-rm -f "$FAKE_JOBS" "$PEKIT_OUT/fake-peinit.log"
+rm -f "$PEKIT_OUT/fake-peinit.log"
 
 # Validate the exact staged package output produced by build.main.
 SRC=$(pwd -P)
