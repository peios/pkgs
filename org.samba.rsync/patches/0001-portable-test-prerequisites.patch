Subject: Keep the comma-only auth test portable without a POSIX account
Author: Peios maintainers <packaging@peios.org>
Origin: vendor, test-only portability adaptation
Forwarded: no

Peios runs rsync's test suite as a build gate in a worker whose UID has no
POSIX account entry, and this test assumed one exists. Preserve comma-only
username checks when no POSIX account exists for the worker's UID; report the
group-rule coverage as unavailable.

--- a/testsuite/daemon-auth-users-comma-only_test.py
+++ b/testsuite/daemon-auth-users-comma-only_test.py
@@ -46,7 +46,7 @@

 from rsyncfns import (
     SCRATCHDIR, makepath, rmtree, rsync_argv, start_test_daemon, test_fail,
-    write_daemon_conf,
+    write_daemon_conf, test_skipped,
 )

 PORT = 12949
@@ -67,7 +67,10 @@
 # The group half needs an auth name the daemon can resolve to a real uid, or
 # getallgroups() finds nothing and no group rule can ever match.
 import pwd
-REALUSER = pwd.getpwuid(os.geteuid()).pw_name
+try:
+    REALUSER = pwd.getpwuid(os.geteuid()).pw_name
+except KeyError:
+    REALUSER = None

 secrets = base / 'auth-users.secrets'
 secrets.write_text(f'{USER}:{PASSWORD}\n{REALUSER}:{PASSWORD}\n')
@@ -142,6 +145,9 @@
 if proc.returncode != 0:
     test_fail(f'transfer was allowed but failed ({ctx})')

+if REALUSER is None:
+    test_skipped('comma-only username assertions passed; group-rule assertions require a resolvable POSIX account')
+
 # Group control: everything the group half depends on must work first.
 proc, landed = push('grpctl', grpc, as_user=REALUSER)
 ctx = f'rc={proc.returncode}, output={proc.stdout.strip()[:300]!r}'
