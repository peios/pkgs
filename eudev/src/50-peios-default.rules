# 50-peios-default.rules — Peios' rewrite of upstream's 50-udev-default.
#
# Upstream's file is almost entirely GROUP= and MODE= assignments: POSIX mode,
# which KACS does not consult. Access to a device node on Peios is its security
# descriptor — the inheritable one prelude seeds on /dev, and the per-node
# exceptions peinit stamps. What survives here is the part that is not
# permissions: the convenience symlinks, the USB identification import, and the
# DMI vendor/model properties.
#
# static_node entries name the nodes for modules that are loaded on first open
# (fuse, tun, kvm, loop-control, …). udev does not create them — the coldplug
# hook does, from the kernel's modules.devname — but naming them here is what
# lets a rule act on them before their module exists. The GROUP=/MODE= that
# accompanied them upstream are gone.

ACTION=="remove", GOTO="peios_default_end"

SUBSYSTEM=="virtio-ports", KERNEL=="vport*", ATTR{name}=="?*", SYMLINK+="virtio-ports/$attr{name}"

# The RTC the kernel set the system clock from, if any, otherwise rtc0.
SUBSYSTEM=="rtc", ATTR{hctosys}=="1", SYMLINK+="rtc"
SUBSYSTEM=="rtc", KERNEL=="rtc0", SYMLINK+="rtc", OPTIONS+="link_priority=-100"

SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", IMPORT{builtin}="usb_id", IMPORT{builtin}="hwdb --subsystem=usb"
ENV{MODALIAS}!="", IMPORT{builtin}="hwdb --subsystem=$env{SUBSYSTEM}"

SUBSYSTEM=="ptp", ATTR{clock_name}=="KVM virtual PTP", SYMLINK+="ptp_kvm"
SUBSYSTEM=="ptp", ATTR{clock_name}=="hyperv", SYMLINK+="ptp_hyperv"

ACTION!="add", GOTO="peios_default_end"

SUBSYSTEM=="sound", OPTIONS+="static_node=snd/seq", OPTIONS+="static_node=snd/timer"
KERNEL=="loop-control", OPTIONS+="static_node=loop-control"
KERNEL=="tun", OPTIONS+="static_node=net/tun"
KERNEL=="fuse", OPTIONS+="static_node=fuse"
KERNEL=="kvm", OPTIONS+="static_node=kvm"
KERNEL=="vfio", OPTIONS+="static_node=vfio/vfio"
KERNEL=="vhost-vsock", OPTIONS+="static_node=vhost-vsock"
KERNEL=="vhost-net", OPTIONS+="static_node=vhost-net"

SUBSYSTEM!="dmi", GOTO="peios_default_end"
ENV{ID_VENDOR}="$attr{sys_vendor}"
ENV{ID_SYSFS_ATTRIBUTE_MODEL}=="|product_name", ENV{ID_MODEL}="$attr{product_name}"
ENV{ID_SYSFS_ATTRIBUTE_MODEL}=="product_version", ENV{ID_MODEL}="$attr{product_version}"
ENV{ID_VENDOR}=="", ENV{ID_VENDOR}="$attr{board_vendor}"
ENV{ID_MODEL}=="", ENV{ID_MODEL}="$attr{board_name}"

LABEL="peios_default_end"
